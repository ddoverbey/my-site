{
  "name": "wanderlog-rarity",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "routes": [
    { "pattern": "api.devonoverbey.com", "custom_domain": true }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://devonoverbey.com,https://www.devonoverbey.com"
  },
  "kv_namespaces": [
    { "binding": "RARITY_CACHE", "id": "f4fa118727df444babd27f3205a0fdc9" }
  ],
  "ratelimits": [
    {
      "name": "RARITY_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
